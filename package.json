{
  "name": "cartpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Profit-aware AI skincare commerce demo for the Razorpay AI Buildathon.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-sites.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:worker": "opennextjs-cloudflare build --skipNextBuild",
    "prepare:sites": "node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "csv-parse": "7.0.2",
    "lucide-react": "1.34.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.86.0"
  }
}
