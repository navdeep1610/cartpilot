{
  "name": "cartpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Profit-aware AI skincare commerce demo for the Razorpay AI Buildathon.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "git diff --check",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:evaluation": "vitest run src/server/evaluation/growth-evaluation.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "validate:contracts": "node scripts/validate-release.mjs",
    "validate:release": "pnpm validate:contracts && pnpm scan:secrets",
    "audit:dependencies": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "ajv": "8.20.0",
    "csv-parse": "7.0.2",
    "lucide-react": "1.34.0",
    "next": "16.3.0",
    "razorpay": "2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
