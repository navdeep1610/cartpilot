  "normalization_contract": {
    "csv_header_policy": "exact_columns_and_order_as_manifest",
    "unknown_csv_column_policy": "reject_snapshot_until_manifest_version_is_updated",
    "unknown_json_property_policy": "follow_the_resource_contract_and_reject_unrecognized_runtime_configuration",
    "identifier_whitespace": "trim_then_reject_if_value_changed",
    "identifier_case": "preserve_and_validate_exact_pattern",
    "boolean_tokens": [
      "true",
      "false"
    ],
    "empty_cell": "null_only_when_the_field_contract_allows_null",
    "multi_value_delimiter": "|",
    "multi_value_normalization": "split_trim_reject_empty_tokens_preserve_declared_order_unless_field_is_a_set",
    "inr_to_paise": "multiply_exact_decimal_INR_by_100_and_require_integer_paise",
    "percentage_to_basis_points": "multiply_exact_percentage_by_100",
    "url_policy": "https_only_when_present",
    "duplicate_array_values": "reject_for_set_semantics"
  },
  "loading_contract": {
    "steps": [
      "load_and_validate_all_json_schemas",
      "verify_every_required_file_exists",
      "verify_SHA_256_for_every_pinned_resource",
      "parse_files_without_type_coercion_side_effects",
      "verify_exact_csv_headers",
      "normalize_values_using_manifest_rules",
      "validate_primary_keys",
      "validate_foreign_keys",
      "validate_cross_file_business_constraints",
      "compile_immutable_catalog_snapshot",
      "compute_runtime_manifest_and_snapshot_hashes",
      "atomically_activate_snapshot",
      "record_catalog_version_policy_versions_and_hashes_on_every_decision"
    ],
    "partial_snapshot_activation_allowed": false,
    "mutable_active_snapshot_allowed": false,
    "hot_reload_strategy": "validate_new_snapshot_completely_then_atomic_swap",
    "failed_reload_strategy": "retain_last_valid_snapshot_and_emit_audit_failure_event",
    "decision_version_pinning_required": true,
    "historical_decision_reconstruction_required": true
  },
  "cross_file_constraints": [
    {
      "constraint_id": "UNIQUE_PRIMARY_KEYS",
      "severity": "fatal",
      "rule": "every_declared_primary_key_is_unique_and_non_empty"
    },
    {
      "constraint_id": "PRODUCT_VARIANT_PARENT",
      "severity": "fatal",
      "rule": "every_product_variants.product_id_exists_in_customer_catalog.product_id"
    },
    {
      "constraint_id": "ONE_DEFAULT_ACTIVE_VARIANT",
      "severity": "fatal",
      "rule": "every_active_product_has_exactly_one_active_variant_where_is_default_is_true"
    },
    {
      "constraint_id": "STARTING_PRICE_RECONCILIATION",
      "severity": "fatal",
      "rule": "customer_catalog.starting_price_inr_equals_the_minimum_price_inr_of_active_variants_for_that_product"
    },
    {
      "constraint_id": "SIZE_DISPLAY_RECONCILIATION",
      "severity": "fatal",
      "rule": "customer_catalog.sizes_available_matches_active_product_variant_sizes_after_documented_display_formatting"
    },
    {
      "constraint_id": "INR_ONLY",
      "severity": "fatal",
      "rule": "every_product_variant_currency_is_INR_and_every_policy_currency_is_INR"
    },
    {
      "constraint_id": "NON_NEGATIVE_PRICE_AND_STOCK",
      "severity": "fatal",
      "rule": "price_inr_is_positive_and_stock_quantity_is_a_non_negative_integer"
    },
    {
      "constraint_id": "COMPLETE_VARIANT_ECONOMICS",
      "severity": "fatal",
      "rule": "every_variant_has_exactly_one_merchant_economics_row_and_no_economics_row_references_an_unknown_variant"
    },
    {
      "constraint_id": "VALID_ECONOMIC_RANGES",
      "severity": "fatal",
      "rule": "costs_and_margin_floors_are_non_negative_expected_return_rate_pct_is_between_0_and_100_and_max_discount_pct_is_between_0_and_100"
    },
    {
      "constraint_id": "COMPLETE_PRODUCT_PROFILES",
      "severity": "fatal_for_automatic_recommendations",
      "rule": "every_customer_catalog_product_has_exactly_one_product_profile"
    },
    {
      "constraint_id": "COMPATIBILITY_REFERENCES_EXIST",
      "severity": "fatal_for_bundle_and_cross_sell_selection",
      "rule": "every_compatibility_source_and_target_product_id_exists"
    },
    {
      "constraint_id": "COMPATIBILITY_DIRECTION_UNAMBIGUOUS",
      "severity": "fatal_for_bundle_and_cross_sell_selection",
      "rule": "no_same_context_pair_has_conflicting_equal_priority_rules_after_directionality_expansion"
    },
    {
      "constraint_id": "BUNDLE_IDENTITIES",
      "severity": "fatal_for_prepriced_bundle_candidates",
      "rule": "every_bundle_product_is_type_Bundle_every_bundle_variant_belongs_to_that_product_and_every_component_variant_belongs_to_its_declared_component_product"
    },
    {
      "constraint_id": "BUNDLE_REQUIRED_COMPONENTS",
      "severity": "fatal_for_prepriced_bundle_candidates",
      "rule": "every_active_bundle_has_at_least_two_active_required_components_with_unique_positive_display_order_and_positive_quantity"
    },
    {
      "constraint_id": "BUNDLE_ECONOMICS_NOT_DOUBLE_COUNTED",
      "severity": "fatal",
      "rule": "prepriced_bundle_profit_uses_the_bundle_variant_economics_row_and_never_adds_component_cost_rows_again"
    },
    {
      "constraint_id": "DISCOUNT_AND_PROFIT_POLICY_ALIGNMENT",
      "severity": "fatal",
      "rule": "currency_amount_unit_decision_mode_cart_floors_incremental_profit_floor_and_score_improvement_floor_match_between_discount_policy_and_profit_policy"
    },
    {
      "constraint_id": "NO_RANDOM_SELECTION",
      "severity": "fatal",
      "rule": "discount_policy_and_profit_policy_both_disable_random_offer_selection_and_profit_policy_disables_MVP_machine_learning_selection"
    },
    {
      "constraint_id": "EVALUATION_REFERENCES",
      "severity": "fatal_in_test",
      "rule": "all_non_empty_catalog_product_variant_offer_trigger_reason_and_payment_state_references_in_evaluation_scenarios_are_valid_for_the_versioned_contract"
    },
    {
      "constraint_id": "PUBLIC_PRIVATE_BOUNDARY",
      "severity": "fatal",
      "rule": "merchant_economics_profit_weights_raw_stock_counts_internal_costs_and policy internals_are_never_returned_by_customer_endpoints_or_customer_logs"
    }
  ],
  "validation_severity_policy": {
    "fatal": "reject_entire_snapshot",
    "fatal_for_automatic_recommendations": "load_public_catalog_but_disable_affected_automatic_recommendation_paths",
    "fatal_for_bundle_and_cross_sell_selection": "disable_affected_bundle_and_cross_sell_candidates",
    "fatal_for_prepriced_bundle_candidates": "disable_affected_prepriced_bundle_candidates",
    "fatal_for_discount_candidate_generation": "disable_all_dynamic_discount_candidates",
    "fatal_for_all_offer_selection": "disable_commercial_recommendations_and_return_safe_unavailable_response",
    "fatal_in_test": "fail_evaluation_and_submission_readiness_checks",
    "warning": "load_only_when_the_rule_explicitly_allows_it_and_emit_audit_warning"
  },
  "public_catalog_projection": {
    "product_fields": [
      "product_id",
      "product_type",
      "product_name",
      "starting_price_inr",
      "sizes_available",
      "use_case",
      "status"
    ],
    "variant_fields": [
      "variant_id",
      "product_id",
      "size",
      "price_inr",
      "currency",
      "is_default",
      "in_stock"
    ],
    "reviewed_profile_fields": [
      "routine_step",
      "supported_skin_types",
      "supported_concerns",
      "usage_period",
      "usage_frequency",
      "customer_warning"
    ],
    "bundle_fields": [
      "bundle_product_id",
      "bundle_variant_id",
      "component_product_id",
      "component_variant_id",
      "quantity",
      "component_role",
      "display_order"
    ],
    "always_blocked_fields": [
      "unit_cost_inr",
      "packaging_cost_inr",
      "fulfilment_cost_inr",
      "expected_return_rate_pct",
      "return_processing_cost_inr",
      "min_contribution_margin_inr",
      "max_discount_pct",
      "inventory_priority",
      "stock_quantity",
      "profit_formula",
      "ranking_weights",
      "candidate_scores",
      "merchant_profit",
      "Razorpay_key_secret",
      "webhook_secret",
      "payment_signature"
    ],
    "price_authority": "product_variants",
    "availability_projection": "boolean_only",
    "internal_cost_disclosure": false,
    "medical_claims_allowed": false
  },
  "runtime_snapshot_contract": {
    "required_snapshot_fields": [
      "manifest_version",
      "catalog_version",
      "manifest_hash",
      "loaded_at",
      "resource_hashes",
      "schema_versions",
      "policy_versions",
      "product_count",
      "variant_count",
      "validation_status"
    ],
    "validation_status_values": [
      "valid",
      "valid_with_disabled_candidate_types",
      "invalid"
    ],
    "snapshot_is_immutable": true,
    "every_offer_decision_records_snapshot_hash": true,
    "every_audit_event_records_relevant_resource_versions": true,
    "order_revalidation_uses_same_or_explicitly_upgraded_valid_snapshot": true,
    "catalog_change_after_customer_confirmation_action": "revalidate_and_require_new_confirmation_if_items_price_discount_or_total_changed"
  },
  "startup_failure_contract": {
    "customer_safe_message": "The catalog is temporarily unavailable. No order or payment has been started.",
    "money_action_authorized": false,
    "order_creation_authorized": false,
    "checkout_authorized": false,
    "existing_last_valid_snapshot_can_remain_active": true,
    "emit_audit_event": true,
    "audit_event_name": "system.data_integrity_failed",
    "secrets_in_error": false,
    "raw_customer_data_in_error": false
  },
  "review_requirements": [
    {
      "review_id": "SKINCARE_EXPERT_REVIEW",
      "required_before": "production_or_public_health_suitability_claims",
      "scope": [
        "product_profiles.csv",
        "product_compatibility.csv",
        "ingredient_data",
        "warnings",
        "source_urls"
      ],
      "current_status": "pending"
    },
    {
      "review_id": "MERCHANT_ECONOMICS_APPROVAL",
      "required_before": "real_merchant_profit_reporting",
      "scope": [
        "merchant_economics.csv",
        "discount_policy.json",
        "profit_policy.json"
      ],
      "current_status": "synthetic_demo_only"
    },
    {
      "review_id": "IMPLEMENTATION_AUTHORIZATION",
      "required_before": "application_code_creation",
      "scope": [
        "architecture",
        "API_contracts",
        "deployment",
        "secrets",
        "database",
        "acceptance_tests"
      ],
      "current_status": "not_yet_authorized"
    }
  ],
  "change_control": {
    "versioning": "semantic_versioning",
    "patch_change": "copy_warning_source_or_non_behavioral_metadata_change",
    "minor_change": "backward_compatible_product_variant_rule_or_scenario_addition",
    "major_change": "identifier_removal_breaking_column_or_schema_change_or_material_formula_semantics_change",
    "checksum_update_required_for_any_byte_change": true,
    "manifest_version_update_required_for_resource_contract_change": true,
    "catalog_version_update_required_for_customer_visible_or_decision_affecting_change": true,
    "policy_version_update_required_for_formula_weight_threshold_gate_or_tie_breaker_change": true,
    "historical_snapshots_retained": true,
    "silent_runtime_mutation_allowed": false
  },
  "notes": [
    "The manifest is a pinned planning snapshot. Editing a listed resource invalidates its checksum until this manifest and the relevant version are deliberately updated.",
    "The public catalog may be shown to customers, but all commercial internals remain merchant-only.",
    "Razorpay Test Mode confirms payment integration behavior; it does not supply or validate the synthetic merchant economics in this catalog.",
    "No application implementation is authorized by this file. It is an input contract for the later implementation specification and approval gate."
  ]
}
